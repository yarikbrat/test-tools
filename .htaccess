# Обмеження доступу до wp-login.php (замініть на свій IP або діапазон)
# ВИКОРИСТОВУЙТЕ З ОБЕРЕЖНІСТЮ! Якщо ваш IP зміниться, ви не зможете увійти.
# Замість цього, краще використовувати плагіни для зміни URL входу або 2FA.
# <Files wp-login.php>
#     Order Deny,Allow
#     Deny from all
#     Allow from 123.456.789.000 # Ваш IP-адрес
# </Files>

# Зміна URL входу (якщо ви вирішили робити це вручну через .htaccess)
# Замініть /my-login на бажаний URL
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteRule ^my-login$ /wp-login.php [QSA,L]
# </IfModule>

# Перенаправлення HTTP на HTTPS (рекомендовано, якщо у вас є SSL)
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>


# ПОЧАТОК WordPress
# Це стандартні правила WordPress, не змінюйте їх, якщо не впевнені
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# КІНЕЦЬ WordPress